# ==============================================================================
# KAIROS 2027 | GRAND EDITION — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ORGANIZER AUTHENTICATION (Mandatory for Admin Console)
# ------------------------------------------------------------------------------
# Set a strong, secret passkey used by the core organizing committee to authenticate
# into the /admin portal. Keep this secret.
ADMIN_MASTER_SECRET=your-random-32-char-admin-secret-key-here

# ------------------------------------------------------------------------------
# 2. GEMINI AI CHATBOT (RAG Knowledge Base)
# ------------------------------------------------------------------------------
# Provide your Google Gemini API key to power the interactive Kairos RAG Assistant.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 3. AWS SES TRANSACTIONAL EMAIL (Optional for Local Dev, Required for Live SES)
# ------------------------------------------------------------------------------
# When left unset, the application automatically runs in truthful local simulation
# mode, logging all confirmation emails directly to the server terminal without errors.
# To activate real production delivery through AWS Simple Email Service:
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SES_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_FROM_EMAIL=sistawscc@gmail.com

# ------------------------------------------------------------------------------
# 4. PUBLIC APPLICATION URL & PERSISTENT DATA DIRECTORY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional persistent mount path (e.g. /var/data on Render Persistent Disk):
# KAIROS_DATA_DIR=/var/data
